# GCP Project Settings
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/sa-key.json

# Storage
RAW_BUCKET_NAME=raw-uploads-your-project-id
PROCESSED_BUCKET_NAME=processed-outputs-your-project-id

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Optional: Email Notifications (Works with Gmail App Passwords, SendGrid, Resend, etc.)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Server Settings (for Push endpoint)
PORT=8080
